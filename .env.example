# ---------------------------------------------------------------------------
# NailedIt environment
#
# Copy to `.env` and fill in. EVERY value here is safe to ship in the app
# bundle — none of them is a secret. The real secrets (Supabase service role,
# Gemini API key, SMTP credentials) live in Supabase Edge Function secrets and
# never appear in this file.
#
# Leave everything blank to run in DEMO MODE with local seed data.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API Keys.
# Use the "publishable" key (sb_publishable_…) or the legacy "anon public" key.
# NEVER the secret / service_role key — it bypasses every security rule.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Cloudflare Turnstile → the SITE key (the secret key goes in Supabase)
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# PostHog → Project Settings (EU region)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry
EXPO_PUBLIC_SENTRY_DSN=
